# ─── API Backend ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL_LOCAL="http://localhost:5000"
NEXT_PUBLIC_API_URL_PROD="https://seranya-back.onrender.com"

# ─── Domaine du site ──────────────────────────────────────────────────────────
# Utilisé pour les metadata SEO (canonical, Open Graph, Twitter Card), le
# sitemap (next-sitemap) et l'audit Lighthouse/PageSpeed. En local, laisser
# la valeur localhost ci-dessous ; en prod : https://www.seranya-blog.com
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ─── Google (PageSpeed / Lighthouse API) ─────────────────────────────────────
NEXT_PUBLIC_GOOGLE_API_KEY="your_google_api_key"

# ─── NextAuth (désactivé pour l'instant, décommenter si OAuth Google activé) ─
# NEXTAUTH_SECRET="your_nextauth_secret"
# NEXTAUTH_URL="http://localhost:3000"
# GOOGLE_CLIENT_ID="your_google_client_id"
# GOOGLE_CLIENT_SECRET="your_google_client_secret"
